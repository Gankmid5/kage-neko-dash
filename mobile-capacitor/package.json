{
  "name": "kage-neko-dash",
  "version": "1.0.0",
  "description": "Kage-Neko Dash - Cyberpunk shinobi cat parkour runner",
  "scripts": {
    "sync:web": "powershell -NoProfile -Command \"Copy-Item -Path '..\\web\\*' -Destination 'www' -Recurse -Force\"",
    "cap:sync": "npm run sync:web && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:bundle": "cd android && .\\gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
